# App
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgres://username:password@your-db-host:5432/your-database

# Keycloak
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=justizia
KEYCLOAK_CLIENT_ID=justizia-backend
KEYCLOAK_CLIENT_SECRET=your-client-secret-here
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS S3
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=justizia-documents

# Clio
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://localhost:3001/clio/oauth/callback

# Encryption (for storing Clio tokens) - Generate a 32-character key
ENCRYPTION_KEY=CHANGE_THIS_TO_32_CHAR_KEY_NOW

# Frontend URL
FRONTEND_URL=http://localhost:3000
